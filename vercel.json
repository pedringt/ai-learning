{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "authenticignorance.site"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "state.authenticignorance.site"
        }
      ],
      "destination": "https://state.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/implementation-context-prototype",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/:path*",
      "permanent": false
    },
    {
      "source": "/state-product-health",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/state-product-health",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/implementation-context-prototype/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site-shell.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "state.contextswitch.tech"
        }
      ],
      "destination": "/implementation-context-prototype"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "state.contextswitch.tech"
        }
      ],
      "destination": "/implementation-context-prototype/:path*"
    }
  ]
}
