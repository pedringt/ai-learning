{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.authenticignorance.site/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.authenticignorance.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.authenticignorance.site/:path*",
      "permanent": true
    },
    {
      "source": "/implementation-context-prototype",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://state.authenticignorance.site/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://state.authenticignorance.site/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://state.authenticignorance.site/:path*",
      "permanent": false
    },
    {
      "source": "/state-product-health",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://state.authenticignorance.site/state-product-health",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/implementation-context-prototype/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/site-shell.css",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    }
  ]
}
