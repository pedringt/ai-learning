{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.authenticignorance.site/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/implementation-context-prototype/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/site-shell.css",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    }
  ]
}
