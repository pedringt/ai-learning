{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ai-learning-rouge.vercel.app"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "authenticignorance.site"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.authenticignorance.site"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "contextswitch.tech"
        }
      ],
      "destination": "https://www.contextswitch.tech/:path*",
      "permanent": true
    },
    {
      "source": "/implementation-context-prototype",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/",
      "permanent": false
    },
    {
      "source": "/implementation-context-prototype/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/:path*",
      "permanent": false
    },
    {
      "source": "/state-product-health",
      "has": [
        {
          "type": "host",
          "value": "www.contextswitch.tech"
        }
      ],
      "destination": "https://state.contextswitch.tech/state-product-health",
      "permanent": false
    },
    {
      "source": "/state-ai-evals",
      "destination": "/state-evals",
      "permanent": true
    },
    {
      "source": "/state-ai-evals.html",
      "destination": "/state-evals",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/AI_Customer_Success_Guide_to_Debugging_Claude_Agents.pdf",
      "destination": "/cheat-sheets/AI_Customer_Success_Guide_to_Debugging_Claude_Agents",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/AI_Governance_Risk_PM_Cheat_Sheet.pdf",
      "destination": "/cheat-sheets/AI_Governance_Risk_PM_Cheat_Sheet",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/AI_Product_Discovery_Questions.pdf",
      "destination": "/cheat-sheets/AI_Product_Discovery_Questions",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/AI_Product_Evals_Cheat_Sheet.pdf",
      "destination": "/cheat-sheets/AI_Product_Evals_Cheat_Sheet",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/AI_Production_Reliability_and_Observability.pdf",
      "destination": "/cheat-sheets/AI_Production_Reliability_and_Observability",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Anatomy_of_an_LLM_Application.pdf",
      "destination": "/cheat-sheets/Anatomy_of_an_LLM_Application",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/BUILD_BOOST_BUY_DECISION_TREE.pdf",
      "destination": "/cheat-sheets/BUILD_BOOST_BUY_DECISION_TREE",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Building_Software_with_AI.pdf",
      "destination": "/cheat-sheets/Building_Software_with_AI",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Claude_Managed_Agents_Tracing_Cheat_Sheet.pdf",
      "destination": "/cheat-sheets/Claude_Managed_Agents_Tracing_Cheat_Sheet",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Efficient_AI_Use_for_Product_Work.pdf",
      "destination": "/cheat-sheets/Efficient_AI_Use_for_Product_Work",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Human_AI_Workflow_Design_Cheat_Sheet.pdf",
      "destination": "/cheat-sheets/Human_AI_Workflow_Design_Cheat_Sheet",
      "permanent": true
    },
    {
      "source": "/cheat-sheets/Testing_and_Evaluating_AI_Systems.pdf",
      "destination": "/cheat-sheets/Testing_and_Evaluating_AI_Systems",
      "permanent": true
    },
    {
      "source": "/assets/AI_Feature_Architecture_Cost_Cheat_Sheet_Plain_v2.pdf",
      "destination": "/state-architecture-cost",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/implementation-context-prototype/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site-shell.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/project-health-investigate.js": {
      "maxDuration": 60
    },
    "api/project-health-github.js": {
      "maxDuration": 20
    },
    "api/project-health-activity.js": {
      "maxDuration": 25
    }
  }
}
