{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state.local/schemas/structured-interpretation-v1.json",
  "title": "StructuredInterpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "topics",
    "outcome",
    "review_recommendations"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "outcome": {
      "type": "string",
      "enum": ["no_review", "review_recommended"]
    },
    "no_review_explanation": {"type": "string", "minLength": 1},
    "review_recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewRecommendation"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "no_review"}},
        "required": ["outcome"]
      },
      "then": {
        "required": ["no_review_explanation"],
        "properties": {"review_recommendations": {"maxItems": 0}}
      },
      "else": {
        "properties": {
          "no_review_explanation": false,
          "review_recommendations": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "reviewRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_action",
        "review_type",
        "decision_question",
        "why_consequential",
        "affected_state_item_ids",
        "proposed_changes"
      ],
      "properties": {
        "review_action": {"type": "string", "enum": ["create", "update_existing"]},
        "existing_review_id": {"type": "string", "minLength": 1},
        "review_type": {
          "type": "string",
          "enum": ["proposed_update", "state_at_risk", "missing_understanding"]
        },
        "decision_question": {"type": "string", "minLength": 1},
        "why_consequential": {"type": "string", "minLength": 1},
        "affected_state_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "grouping_reason": {"type": "string", "minLength": 1},
        "proposed_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/proposedChange"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_action": {"const": "create"}},
            "required": ["review_action"]
          },
          "then": {"properties": {"existing_review_id": false}},
          "else": {"required": ["existing_review_id"]}
        },
        {
          "if": {
            "properties": {"review_type": {"const": "proposed_update"}},
            "required": ["review_type"]
          },
          "then": {"properties": {"proposed_changes": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {"review_type": {"const": "missing_understanding"}},
            "required": ["review_type"]
          },
          "then": {
            "properties": {
              "proposed_changes": {
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/proposedChange"},
                    {"properties": {"operation": {"const": "create"}}}
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"properties": {"affected_state_item_ids": {"minItems": 2}}},
              {"properties": {"proposed_changes": {"minItems": 2}}}
            ]
          },
          "then": {"required": ["grouping_reason"]},
          "else": {"properties": {"grouping_reason": false}}
        }
      ]
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "rationale"],
      "properties": {
        "operation": {"type": "string", "enum": ["create", "update", "retire"]},
        "state_item_id": {"type": "string", "minLength": 1},
        "expected_version": {"type": "integer", "minimum": 1},
        "proposed_statement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "format": "date"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"const": "create"}},
            "required": ["operation"]
          },
          "then": {
            "required": ["proposed_statement"],
            "properties": {
              "state_item_id": false,
              "expected_version": false
            }
          }
        },
        {
          "if": {
            "properties": {"operation": {"const": "update"}},
            "required": ["operation"]
          },
          "then": {
            "required": ["state_item_id", "expected_version", "proposed_statement"]
          }
        },
        {
          "if": {
            "properties": {"operation": {"const": "retire"}},
            "required": ["operation"]
          },
          "then": {
            "required": ["state_item_id", "expected_version"],
            "properties": {"proposed_statement": false}
          }
        }
      ]
    }
  }
}
